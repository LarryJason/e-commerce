# Base PostgreSQL
# Avec Docker : `npm run db:up` crée un conteneur avec ces paramètres.
# Avec un serveur PostgreSQL existant : adaptez DATABASE_URL et ignorez les variables POSTGRES_*.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=changez-moi
POSTGRES_PORT=5433
DATABASE_URL=postgres://ecommerce:changez-moi@127.0.0.1:5433/ecommerce

# Secret serveur (générez-le avec : openssl rand -hex 32)
#SESSION_SECRET=a7Kp2mQ9xR4vN8cL3zT6bY1wD5hJ0sF2

# Base dédiée aux tests d'intégration (son nom doit finir par _test : elle est vidée par les tests)
TEST_DATABASE_URL=postgres://ecommerce:changez-moi@127.0.0.1:5433/ecommerce_test
